{
  "name": "ciji-purchase",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:next": "next dev",
    "build:next": "next build  && npm run build:electron && electron-builder",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start:electron": "npm run build:electron && electron .",
    "dev": "concurrently \"npm run dev:next\" \"wait-on http://localhost:3000 && npm run start:electron\"",
    "build": "next build"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dropzone": "^9.7.4",
    "@mantine/form": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "firebase": "^13.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/electron": "^1.4.38",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.ciji.purchase",
    "productName": "CIJI Purchase",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
